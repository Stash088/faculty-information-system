FROM node:18-alpine

RUN apk add --no-cache curl tini

ENV NODE_OPTIONS="--max-old-space-size=2048"

WORKDIR /app

# Копируем package.json всех частей
COPY backend/package*.json ./backend/
COPY frontend/package*.json ./frontend/

# Устанавливаем зависимости
RUN cd backend && npm ci --omit=dev --no-audit --no-fund && cd ..
RUN cd frontend && npm ci --no-audit --no-fund --loglevel=error

# Копируем исходники
COPY backend ./backend
COPY frontend ./frontend

# Собираем frontend
RUN cd frontend && npm run build 2>&1 | tail -20

# Подготовка runtime
WORKDIR /app/backend
RUN mkdir -p logs uploads public && \
    cp -r /app/frontend/dist/* public/ && \
    chown -R node:node .

USER node

ENV NODE_ENV=production
ENV PORT=3000

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD curl -sf http://127.0.0.1:3000/api/health || exit 1

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "src/app.js"]
