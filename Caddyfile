# Шаблон Caddyfile для деплоя на VPS
# Скопируй на сервер: scp Caddyfile root@VPS:/etc/caddy/Caddyfile
# Затем: systemctl restart caddy

{
    admin off
}

# Замени faculty-agu.ru на свой домен
faculty-agu.ru, www.faculty-agu.ru {
    reverse_proxy localhost:3000 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto https
    }
    
    log {
        output file /var/log/caddy/faculty.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}
