# Backend (Node.js)
NODE_ENV=production
PORT=3000

# Managed PostgreSQL
DB_HOST=your-db-host.twc1.net
DB_PORT=5432
DB_NAME=default_db
DB_USER=gen_user
DB_PASSWORD=your_secure_password

# JWT — сгенерируй новые через:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change_me_64_hex_characters_minimum_required
JWT_REFRESH_SECRET=change_me_64_hex_characters_minimum_required
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# CORS — * для dev или конкретный домен
CLIENT_URL=*

# File upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads
